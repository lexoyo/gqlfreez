<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ api.countries | length }} countries</title>
  </head>
  <body>
    <h1>{{ api.countries | length }} countries</h1>
    <ul>
    {%- for country in api.countries %}
      <li>{{ country.emoji }} {{ country.name }} — {{ country.capital or "no capital" }}</li>
    {%- endfor %}
    </ul>
  </body>
</html>
