---
# One page per country. `size: 1` is the Eleventy idiom for "a page per entry" —
# the same thing a headless WordPress blog does to get a page per post.
pagination:
  data: api.countries
  size: 1
  alias: country
permalink: "/country/{{ country.code | lower }}/"
layout: base.njk
eleventyComputed:
  title: "{{ country.name }}"
---
<h1>{{ country.emoji }} {{ country.name }}</h1>

<dl>
  <dt>Code</dt><dd>{{ country.code }}</dd>
  <dt>Capital</dt><dd>{{ country.capital or "—" }}</dd>
  <dt>Continent</dt><dd>{{ country.continent.name }}</dd>
  <dt>Languages</dt>
  <dd>
    {%- for language in country.languages %}{{ language.name }}{% if not loop.last %}, {% endif %}{% else %}—{% endfor %}
  </dd>
</dl>
